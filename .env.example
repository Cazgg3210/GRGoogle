# ---------------------------------------------------------------------------
# SMLXL Meeting Intelligence — variables de entorno (sin valores reales)
# Copiar a .env. Nunca subir .env al repositorio.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT_API=4000
PORT_WEB=3000
LOG_LEVEL=info
COMPANY_TIMEZONE=America/Mexico_City

# PostgreSQL (docker compose expone 5460 por defecto)
DATABASE_URL=postgresql://smlxl:smlxl_password@localhost:5460/smlxl?schema=public

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# En desarrollo permite iniciar sesion como usuario seed sin Google OAuth (NUNCA en produccion)
AUTH_DEV_BYPASS=true
# Correo usado por la web (solo con bypass) para listar usuarios demo en el login
AUTH_DEV_BOOTSTRAP_EMAIL=gestora@smlxl.mx

# Google OAuth (login de usuarios @smlxl.mx)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=smlxl.mx

# Google Cloud / Workspace APIs (Fase 2)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_PUBSUB_PUSH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Ruta a archivo JSON o JSON en linea (preferir secret manager en produccion)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# IA (Fase 3). El backend usa Gemini API / Vertex AI como servicio independiente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1

# Salidas
GOOGLE_SHEETS_SPREADSHEET_ID=
GMAIL_SENDER_EMAIL=

# Feature flags (seccion 51). Con todo en false la plataforma corre con adapters fake.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_MEET_EVENTS_ENABLED=false
AI_PROCESSING_ENABLED=false
AI_COMPLETION_PROPOSALS_ENABLED=true
GMAIL_NOTIFICATIONS_ENABLED=false
SHEETS_SYNC_ENABLED=false
WEEKLY_DIGEST_ENABLED=true
