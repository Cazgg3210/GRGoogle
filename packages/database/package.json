{
  "name": "@smlxl/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema ../../prisma/schema.prisma",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema ../../prisma/schema.prisma",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --schema ../../prisma/schema.prisma",
    "studio": "dotenv -e ../../.env -- prisma studio --schema ../../prisma/schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push --schema ../../prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx ../../prisma/seed.ts",
    "build": "prisma generate --schema ../../prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo src/generated"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@smlxl/config": "workspace:*",
    "@smlxl/domain": "workspace:*"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
